{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["intent", "confidence", "reason"],
  "additionalProperties": false,
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["RAG", "SQL", "HYBRID", "BLOCKED"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
