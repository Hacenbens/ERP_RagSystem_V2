{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["merged_answer", "sql_contribution", "rag_contribution", "contradictions", "overall_confidence", "cited_chunks", "sql_tables_used"],
  "additionalProperties": false,
  "properties": {
    "merged_answer": {
      "type": "string"
    },
    "sql_contribution": {
      "type": "string"
    },
    "rag_contribution": {
      "type": "string"
    },
    "contradictions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "overall_confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "cited_chunks": {
      "type": "array",
      "items": {"type": "string"}
    },
    "sql_tables_used": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
