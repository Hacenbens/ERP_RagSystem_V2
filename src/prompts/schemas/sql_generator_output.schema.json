{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["sql", "tables_used", "confidence"],
  "additionalProperties": false,
  "properties": {
    "sql": {
      "type": "string",
      "minLength": 1
    },
    "tables_used": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  }
}
