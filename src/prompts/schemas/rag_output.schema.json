{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["grounded", "answer", "cited_chunks", "confidence", "insufficient_data_for"],
  "additionalProperties": false,
  "properties": {
    "grounded": {
      "type": "boolean"
    },
    "answer": {
      "type": ["string", "null"]
    },
    "cited_chunks": {
      "type": "array",
      "items": {"type": "string"}
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "insufficient_data_for": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
