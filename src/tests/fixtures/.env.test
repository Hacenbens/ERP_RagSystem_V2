# Test environment — used by integration tests
# Copy to .env when running against a real ERP PostgreSQL instance
# NEVER commit real credentials — use CI secrets for real values

ERP_PG_HOST=localhost
ERP_PG_PORT=5432
ERP_PG_DATABASE=erp_test
ERP_PG_USER=erp_readonly
ERP_PG_PASSWORD=test_password_change_me
ERP_PG_DSN=postgresql://erp_readonly:test_password_change_me@localhost:5432/erp_test

# Evaluation thresholds
SQL_SUCCESS_MIN=0.95
HALLUCINATION_MAX=0.05
RAG_PRECISION_MIN=0.70

# JWT (ephemeral key used in tests — real keys injected via CI secrets)
JWT_EXPIRY_MINUTES=60
