# .env.example — copy to .env and fill in real values
# NEVER commit .env with real secrets

# MinIO credentials
# Set MINIO_ENDPOINT (host:port, no scheme) to store uploads in MinIO instead
# of on local disk. Required whenever the API and worker are separate
# containers or hosts — a local path is not shared between them.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_password_change_me

# JWT signing key (RS256 — provide a PEM private key path in Sprint 3)
JWT_SECRET_KEY=change_me_in_production

# OpenAI API key (kept for reference; primary LLM is now Gemini — Sprint 8)
OPENAI_API_KEY=sk-...

# Google Gemini API key — primary LLM provider (free tier: gemini-2.5-flash-lite)
GEMINI_API_KEY=AIzaSyDsqrMlNev7FWlxkqmGP_5KgB5QOJ-obQg
# Google retires model ids. gemini-2.5-flash-lite now returns 404 'no longer
# available to new users'. Use a current id, or gemini-flash-lite-latest to
# track the moving alias.
GEMINI_MODEL=gemini-3.5-flash-lite

# vLLM self-hosted fallback endpoint (Sprint 8 circuit-breaker fallback)
VLLM_BASE_URL=http://localhost:8000
VLLM_MODEL=mistralai/Mistral-7B-Instruct-v0.2
VLLM_API_KEY=not-required

# Ngrok-backed model endpoints (Sprint 7 experimentation / Sprint 8 provider wiring)
NGROK_BASE_URL=https://reserveless-uncompanionable-terina.ngrok-free.dev
NGROK_API_KEY=
NGROK_EMBEDDING_ENDPOINT=/embed
NGROK_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
NGROK_RERANKER_ENDPOINT=/rerank

# Evaluation thresholds (Sprint 2)
SQL_SUCCESS_MIN=0.95
HALLUCINATION_MAX=0.05
RAG_PRECISION_MIN=0.70

# Asset storage path for uploaded documents (Sprint 7)
ASSET_STORAGE_PATH=/tmp/erp_rag_assets

# ERP PostgreSQL (read-only target for SQL pipeline — Sprint 4)
ERP_PG_HOST=localhost
ERP_PG_PORT=5432
ERP_PG_DATABASE=erp_prod
ERP_PG_USER=erp_readonly
ERP_PG_PASSWORD=change_me

# ── Vector store ─────────────────────────────────────────────────────────────
# Milvus server: http://localhost:19530  <- required for API + worker
# Milvus Lite:   a local file path, e.g. ./milvus_erp_rag.db
# Leave blank for the in-memory fallback (data lost on exit).
#
# Lite is a single-process file lock. It is fine for one process, but the API
# and the Celery worker cannot both open it — the second dies with
# "Open local milvus failed". Any deployment with a separate worker needs the
# server, which docker-compose already provides.
#
# NOT named MILVUS_URI. pymilvus reads a variable of that exact name at import
# time and requires an http[s]:// address, so pointing MILVUS_URI at a Lite
# file path kills the process before any project code runs.
MILVUS_DB_URI=

# ── MongoDB (chunks, idempotency, dead letters) ──────────────────────────────
# Include credentials if your server requires auth, e.g.
#   mongodb://user:password@localhost:27017/?authSource=admin
# Leave blank for the in-memory fallback.
MONGODB_URI=

# ── JWT signing keys (RS256) ─────────────────────────────────────────────────
# Without these every process generates its own throwaway keypair: two uvicorn
# workers reject each other's tokens and a restart logs everyone out.
#
# Generate a pair:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt_private.pem
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
#
# Point at the files (simplest), or inline the PEM text in the *_PEM variables.
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
