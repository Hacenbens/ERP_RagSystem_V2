# .env.example — copy to .env and fill in real values
# NEVER commit .env with real secrets

# MinIO credentials
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_password_change_me

# JWT signing key (RS256 — provide a PEM private key path in Sprint 3)
JWT_SECRET_KEY=change_me_in_production

# OpenAI API key (used by query_generator and LLM client)
OPENAI_API_KEY=sk-...

# Ngrok-backed model endpoints (Sprint 7 experimentation / Sprint 8 provider wiring)
NGROK_BASE_URL=https://your-subdomain.ngrok-free.app
NGROK_API_KEY=
NGROK_EMBEDDING_ENDPOINT=/embeddings
NGROK_EMBEDDING_MODEL=
NGROK_RERANKER_ENDPOINT=/rerank

# Evaluation thresholds (Sprint 2)
SQL_SUCCESS_MIN=0.95
HALLUCINATION_MAX=0.05
RAG_PRECISION_MIN=0.70

# ERP PostgreSQL (read-only target for SQL pipeline — Sprint 4)
ERP_PG_HOST=localhost
ERP_PG_PORT=5432
ERP_PG_DATABASE=erp_prod
ERP_PG_USER=erp_readonly
ERP_PG_PASSWORD=change_me
